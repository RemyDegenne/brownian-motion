end MeasureTheory

lemma MeasurableSet.of_mem_countableInfClosure {m𝓧 : MeasurableSpace 𝓧}
    {s : Set 𝓧} {p : Set (Set 𝓧)} (hs : s ∈ countableInfClosure p) (hp : ∀ t ∈ p, MeasurableSet t) :
    MeasurableSet s := by
  rw [mem_countableInfClosure_iff_iInf] at hs
  obtain ⟨t, ht, rfl⟩ := hs
  exact MeasurableSet.iInter fun n ↦ hp (t n) (ht n)

lemma MeasurableSet.of_mem_countableSupClosure {m𝓧 : MeasurableSpace 𝓧}
    {s : Set 𝓧} {p : Set (Set 𝓧)} (hs : s ∈ countableSupClosure p) (hp : ∀ t ∈ p, MeasurableSet t) :
    MeasurableSet s := by
  rw [mem_countableSupClosure_iff_iSup] at hs
  obtain ⟨t, ht, rfl⟩ := hs
  exact MeasurableSet.iUnion fun n ↦ hp (t n) (ht n)

lemma MeasurableSet.of_mem_supClosure {m𝓧 : MeasurableSpace 𝓧} {s : Set 𝓧}
    {p : Set (Set 𝓧)} (hs : s ∈ supClosure p) (hp : ∀ t ∈ p, MeasurableSet t) :
    MeasurableSet s := by
  rw [mem_supClosure_set_iff'] at hs
  obtain ⟨t, _, A, ht, h_eq⟩ := hs
  rw [h_eq]
  exact MeasurableSet.biUnion (Finset.countable_toSet t) fun n hn ↦ hp (A n) (ht n hn)

lemma MeasurableSet.of_mem_image2_prod {Ω 𝓧 : Type*}
    {mΩ : MeasurableSpace Ω} {m𝓧 : MeasurableSpace 𝓧}
    {s : Set (𝓧 × Ω)} {p : Set (Set 𝓧)} {q : Set (Set Ω)} (hs : s ∈ Set.image2 (· ×ˢ ·) p q)
    (hp : ∀ t ∈ p, MeasurableSet t) (hq : ∀ t ∈ q, MeasurableSet t) :
    MeasurableSet s := by
  obtain ⟨A, hA, B, hB, rfl⟩ := hs
  exact MeasurableSet.prod (hp A hA) (hq B hB)

end Aux

namespace MeasureTheory

/-- A set `s` is analytic for a paving `p` and a type `𝓚` if there exists a compact system `q` of
`𝓚` such that `s` is the projection of a set `t ∈ prodSigmaDelta p q`. -/
def IsPavingAnalyticFor (p : Set (Set 𝓧)) (𝓚 : Type*) (s : Set 𝓧) : Prop :=
  ∃ q : Set (Set 𝓚), IsCompactSystem q ∧
    ∃ t : Set (𝓧 × 𝓚), t ∈ prodSigmaDelta p q ∧ s = Prod.fst '' t

/-- A set `s` is analytic for a paving `p` if there exists a type `𝓚` and a compact system `q` of
`𝓚` such that `s` is the projection of a set `t ∈ prodSigmaDelta p q`. -/
def IsPavingAnalytic (p : Set (Set 𝓧)) (s : Set 𝓧) : Prop :=
  ∃ 𝓚 : Type, IsPavingAnalyticFor p 𝓚 s

/-- The auxiliary space in the definition of analytic sets can always be taken to be `ℕ → ℕ`. -/
lemma IsPavingAnalyticFor.isPavingAnalyticFor_nat_nat (hs : IsPavingAnalyticFor p 𝓚 s) :
    IsPavingAnalyticFor p (ℕ → ℕ) s := by
  classical
  obtain ⟨q, hq, t, ht, rfl⟩ := hs
  obtain ⟨A, hA, K, hK, rfl⟩ := mem_prodSigmaDelta_iff.mp ht
  -- encode a point `k` by the set of indices `(n, m)` such that `k ∈ K n m`
  let φ : 𝓚 → ℕ → ℕ := fun k j ↦ if k ∈ K j.unpair.1 j.unpair.2 then 1 else 0
  have hφ n m : φ ⁻¹' (φ '' K n m) = K n m := by
    refine subset_antisymm ?_ (Set.subset_preimage_image _ _)
    rintro k' ⟨k, hk, h⟩
    have h_nm := congrFun h (Nat.pair n m)
    simp only [φ, Nat.unpair_pair, hk, ↓reduceIte] at h_nm
    by_contra hk'
    simp [hk'] at h_nm
  refine ⟨(φ '' ·) '' {t | ∃ n m, K n m = t}, ?_, ⋂ n, ⋃ m, A n m ×ˢ (φ '' K n m),
    mem_prodSigmaDelta_iff.mpr ⟨A, hA, _, fun n m ↦ ⟨K n m, ⟨n, m, rfl⟩, rfl⟩, rfl⟩, ?_⟩
  · refine (hq.mono ?_).image ?_
    · rintro _ ⟨n, m, rfl⟩
      exact hK n m
    · rintro _ ⟨n, m, rfl⟩
      exact hφ n m
  -- the points of `𝓚` with the same image by `φ` belong to the same sets `K n m`
  ext x
  simp only [Set.mem_image, Set.mem_iInter, Set.mem_iUnion, Set.mem_prod, Prod.exists,
    exists_and_right, exists_eq_right]
  constructor
  · rintro ⟨k, hk⟩
    exact ⟨φ k, fun n ↦ (hk n).imp fun m h ↦ ⟨h.1, k, h.2, rfl⟩⟩
  · rintro ⟨τ, hτ⟩
    obtain ⟨-, -, k, -, rfl⟩ := hτ 0
    refine ⟨k, fun n ↦ (hτ n).imp fun m ⟨hxA, hk⟩ ↦ ⟨hxA, ?_⟩⟩
    rw [← hφ n m]
    exact hk

lemma IsPavingAnalyticFor.isPavingAnalytic (hs : IsPavingAnalyticFor p 𝓚 s) :
    IsPavingAnalytic p s :=
  ⟨ℕ → ℕ, hs.isPavingAnalyticFor_nat_nat⟩

lemma isPavingAnalyticFor_of_mem (𝓚 : Type*) [Nonempty 𝓚] (hs : s ∈ p) :
    IsPavingAnalyticFor p 𝓚 s :=
  ⟨{Set.univ, ∅}, isCompactSystem_singleton_empty.insert_univ, s ×ˢ .univ,
    prod_mem_prodSigmaDelta hs (by simp), (Set.fst_image_prod s Set.univ_nonempty).symm⟩

lemma isPavingAnalytic_of_mem (hs : s ∈ p) : IsPavingAnalytic p s :=
  (isPavingAnalyticFor_of_mem Unit hs).isPavingAnalytic

lemma IsPavingAnalyticFor.mono {p' : Set (Set 𝓧)} (hp : p ⊆ p') (hs : IsPavingAnalyticFor p 𝓚 s) :
    IsPavingAnalyticFor p' 𝓚 s :=
  let ⟨q, hq, t, ht, hs⟩ := hs
  ⟨q, hq, t, prodSigmaDelta_mono hp subset_rfl ht, hs⟩

lemma IsPavingAnalytic.mono {p' : Set (Set 𝓧)} (hp : p ⊆ p') (hs : IsPavingAnalytic p s) :
    IsPavingAnalytic p' s :=
  let ⟨_, hs⟩ := hs
  (hs.mono hp).isPavingAnalytic

/-- An analytic set for `p` is contained in a countable union of sets of `p`. See the paragraph
after Definition 1.25 of [he2019semimartingale]. -/
lemma IsPavingAnalyticFor.exists_mem_countableSupClosure_superset (hs : IsPavingAnalyticFor p 𝓚 s) :
    ∃ t ∈ countableSupClosure p, s ⊆ t := by
  obtain ⟨q, -, B, hB, rfl⟩ := hs
  obtain ⟨A, hA, K, -, rfl⟩ := mem_prodSigmaDelta_iff.mp hB
  refine ⟨⋃ m, A 0 m, iSup_mem_countableSupClosure (hA 0), ?_⟩
  rintro _ ⟨y, hy, rfl⟩
  obtain ⟨m, hm, -⟩ := Set.mem_iUnion.mp (Set.mem_iInter.mp hy 0)
  exact Set.mem_iUnion.mpr ⟨m, hm⟩

lemma isPavingAnalyticFor_empty (𝓚 : Type*) (hp : p.Nonempty) : IsPavingAnalyticFor p 𝓚 ∅ :=
  let ⟨A, hA⟩ := hp
  ⟨{Set.univ, ∅}, isCompactSystem_singleton_empty.insert_univ, A ×ˢ ∅,
    prod_mem_prodSigmaDelta hA (by simp), by simp⟩

@[simp]
lemma isPavingAnalytic_empty (hp : p.Nonempty) : IsPavingAnalytic p ∅ :=
  (isPavingAnalyticFor_empty Unit hp).isPavingAnalytic

@[simp]
lemma isPavingAnalyticFor_iff_eq_empty [IsEmpty 𝓚] (hp : p.Nonempty) :
    IsPavingAnalyticFor p 𝓚 s ↔ s = ∅ :=
  ⟨fun ⟨_, _, t, _, hs⟩ ↦ by simp [hs, Set.eq_empty_of_isEmpty t],
    fun hs ↦ hs ▸ isPavingAnalyticFor_empty 𝓚 hp⟩

/-- A countable intersection of analytic sets is analytic. Theorem 1.26 of
[he2019semimartingale]. -/
lemma IsPavingAnalyticFor.iInter [Countable ι] [Nonempty ι] {𝓚 : ι → Type*} {s : ι → Set 𝓧}
    (hs : ∀ i, IsPavingAnalyticFor p (𝓚 i) (s i)) :
    IsPavingAnalyticFor p (Π i, 𝓚 i) (⋂ i, s i) := by
  classical
  choose q hq B hB hs_eq using hs
  -- the set `⋂ i, s i` is the projection of the set of `(x, y)` with `(x, y i) ∈ B i` for all `i`
  refine ⟨Set.univ.pi '' Set.univ.pi (fun i ↦ insert Set.univ (q i)),
    IsCompactSystem.pi fun i ↦ (hq i).insert_univ, ⋂ i, Prod.map id (Function.eval i) ⁻¹' B i,
    countableInfClosed_prodSigmaDelta.iInf_mem fun i ↦
      prodSigmaDelta_mono ?_ ?_ (preimage_prodMap_mem_prodSigmaDelta (hB i)), ?_⟩
  · rintro _ ⟨A, hA, rfl⟩
    exact hA
  · rintro _ ⟨K, hK, rfl⟩
    refine ⟨Function.update (fun _ ↦ Set.univ) i K, fun j _ ↦ ?_, Set.eval_preimage.symm⟩
    rcases eq_or_ne j i with rfl | hj
    · simpa using .inr hK
    · simp [hj]
  · ext x
    simp only [hs_eq, Set.mem_iInter, Set.mem_image, Set.mem_preimage, Prod.map_apply, id_eq,
      Function.eval, Prod.exists, exists_and_right, exists_eq_right]
    refine ⟨fun h ↦ ?_, fun ⟨y, hy⟩ i ↦ ⟨y i, hy i⟩⟩
    choose y hy using h
    exact ⟨y, hy⟩

/-- A countable intersection of analytic sets is analytic. Theorem 1.26 of
[he2019semimartingale]. -/
lemma IsPavingAnalytic.iInter [Countable ι] [Nonempty ι] {s : ι → Set 𝓧}
    (hs : ∀ i, IsPavingAnalytic p (s i)) :
    IsPavingAnalytic p (⋂ i, s i) := by
  obtain ⟨f, hf⟩ := exists_surjective_nat ι
  rw [← hf.iInter_comp]
  choose 𝓚 hs𝓚 using hs
  exact (IsPavingAnalyticFor.iInter fun n ↦ hs𝓚 (f n)).isPavingAnalytic

/-- A countable union of analytic sets is analytic. Theorem 1.26 of [he2019semimartingale]. -/
lemma IsPavingAnalyticFor.iUnion {𝓚 : ℕ → Type*} {s : ℕ → Set 𝓧}
    (hs : ∀ n, IsPavingAnalyticFor p (𝓚 n) (s n)) :
    IsPavingAnalyticFor p (Σ n, 𝓚 n) (⋃ n, s n) := by
  choose q hq_compact B hB_prod hB_eq using hs
  let C := Prod.swap ''
    ((Equiv.sigmaProdDistrib 𝓚 𝓧).symm '' (Set.sigma Set.univ (fun n ↦ Prod.swap '' (B n))))
  let q'' := {t : Set (Σ n, 𝓚 n) |
    ∃ s : Finset ℕ, t ∈ (s : Set ℕ).sigma '' (Set.univ.pi (fun n ↦ insert Set.univ (q n)))}
  refine ⟨q'', ?_, C, ?_, ?_⟩
  · exact IsCompactSystem.sigma (fun n ↦ (hq_compact n).insert_univ)
  · unfold prodSigmaDelta at hB_prod
    simp_rw [mem_countableInfClosure_iff_iInf] at hB_prod
    choose A hA hB_eq using hB_prod
    have hC_eq : C = ⋂ k, Prod.swap '' ((Equiv.sigmaProdDistrib 𝓚 𝓧).symm ''
        (Set.sigma Set.univ (fun n ↦ Prod.swap '' (A n k)))) := by
      simp only [C, ← hB_eq]
      rw [← Set.image_iInter Prod.swap_bijective, ← Set.image_iInter (Equiv.bijective _)]
      simp only [Equiv.sigmaProdDistrib_symm_apply, Set.iInf_eq_iInter]
      simp_rw [Set.image_iInter Prod.swap_bijective]
      congr
      ext
      simp
    rw [hC_eq]
    refine countableInfClosed_countableInfClosure.iInf_mem fun k ↦ subset_countableInfClosure ?_
    simp_rw [mem_countableSupClosure_image2_prod_iff] at hA
    choose B hB K hK hA_eq using hA
    simp_rw [← hA_eq]
    have h_eq : Prod.swap '' ((Equiv.sigmaProdDistrib 𝓚 𝓧).symm '' Set.univ.sigma
        fun n ↦ Prod.swap '' ⋃ n_1, B n k n_1 ×ˢ K n k n_1)
      = ⋃ n_1, Prod.swap '' ((Equiv.sigmaProdDistrib 𝓚 𝓧).symm '' Set.univ.sigma
        fun n ↦ Prod.swap '' (B n k n_1 ×ˢ K n k n_1)) := by ext; simp; grind
    rw [h_eq]
    refine countableSupClosed_countableSupClosure.iSup_mem fun i ↦ ?_
    simp only [Set.image_swap_prod, Set.sigma_eq_biUnion, Set.mem_univ, Set.iUnion_true,
      Set.image_iUnion]
    refine countableSupClosed_countableSupClosure.iSup_mem fun j ↦ subset_countableSupClosure ?_
    refine ⟨B j k i, hB _ _ _, Sigma.mk j '' (K j k i), ?_, by ext; simp; grind⟩
    simp only [Set.mem_image, Set.mem_pi, Set.mem_univ, Set.mem_ofPred_eq, forall_const, q'']
    refine ⟨{j}, fun j ↦ K j k i, ?_⟩
    simp only [Finset.coe_singleton, Set.singleton_sigma, and_true]
    exact fun m ↦ .inr (hK _ _ _)
  · simp only [hB_eq, Equiv.sigmaProdDistrib_symm_apply, C]
    ext y
    simp only [Set.mem_iUnion, Set.mem_image, Prod.exists, exists_and_right, exists_eq_right,
      Set.mem_sigma_iff, Set.mem_univ, Prod.swap_prod_mk, true_and, Sigma.exists, Prod.mk.injEq,
      ↓existsAndEq, exists_eq_right_right, Sigma.mk.injEq, and_true]
    grind

/-- A countable union of analytic sets is analytic. Theorem 1.26 of [he2019semimartingale]. -/
lemma IsPavingAnalytic.iUnion {s : ℕ → Set 𝓧} (hs : ∀ n, IsPavingAnalytic p (s n)) :
    IsPavingAnalytic p (⋃ n, s n) := by
  choose 𝓚 hs𝓚 using hs
  exact (IsPavingAnalyticFor.iUnion hs𝓚).isPavingAnalytic

/-- The intersection of two analytic sets is analytic. Theorem 1.26 of [he2019semimartingale]. -/
lemma IsPavingAnalyticFor.inter (hs : IsPavingAnalyticFor p 𝓚 s) (ht : IsPavingAnalyticFor p 𝓚' t) :
    IsPavingAnalyticFor p (𝓚 × 𝓚') (s ∩ t) := by
  obtain ⟨q, hq, B, hB, rfl⟩ := hs
  obtain ⟨q', hq', B', hB', rfl⟩ := ht
  -- the set `s ∩ t` is the projection of the set of `(x, y, y')` with `(x, y) ∈ B` and
  -- `(x, y') ∈ B'`
  refine ⟨Set.image2 (· ×ˢ ·) (insert Set.univ q) (insert Set.univ q'),
    hq.insert_univ.prod hq'.insert_univ,
    Prod.map id Prod.fst ⁻¹' B ∩ Prod.map id Prod.snd ⁻¹' B',
    countableInfClosed_prodSigmaDelta.infClosed
      (prodSigmaDelta_mono ?_ ?_ (preimage_prodMap_mem_prodSigmaDelta hB))
      (prodSigmaDelta_mono ?_ ?_ (preimage_prodMap_mem_prodSigmaDelta hB')), ?_⟩
  · rintro _ ⟨A, hA, rfl⟩
    exact hA
  · rintro _ ⟨K, hK, rfl⟩
    exact ⟨K, .inr hK, Set.univ, .inl rfl, Set.prod_univ⟩
  · rintro _ ⟨A, hA, rfl⟩
    exact hA
  · rintro _ ⟨K, hK, rfl⟩
    exact ⟨Set.univ, .inl rfl, K, .inr hK, Set.univ_prod⟩
  · ext
    simp

/-- The intersection of two analytic sets is analytic. Theorem 1.26 of [he2019semimartingale]. -/
lemma IsPavingAnalytic.inter (hs : IsPavingAnalytic p s) (ht : IsPavingAnalytic p t) :
    IsPavingAnalytic p (s ∩ t) :=
  let ⟨_, hs⟩ := hs
  let ⟨_, ht⟩ := ht
  (hs.inter ht).isPavingAnalytic

/-- The union of two analytic sets is analytic. Theorem 1.26 of [he2019semimartingale]. -/
lemma IsPavingAnalyticFor.union {𝓚' : Type*} {t : Set 𝓧}
    (hs : IsPavingAnalyticFor p 𝓚 s) (ht : IsPavingAnalyticFor p 𝓚' t) :
    IsPavingAnalyticFor p (𝓚 ⊕ 𝓚') (s ∪ t) := by
  choose q hq_compact B hB_prod hB_eq using hs
  choose q' hq'_compact B' hB'_prod hB'_eq using ht
  -- `s ∪ t` is the projection of the set `C` of `𝓧 × (𝓚 ⊕ 𝓚')` that is `B` above `𝓚` and `B'`
  -- above `𝓚'`, and the compact system is given by `q` on `𝓚` and `q'` on `𝓚'` (with `∅` and
  -- `univ` added)
  let C : Set (𝓧 × (𝓚 ⊕ 𝓚')) :=
    (Equiv.prodSumDistrib 𝓧 𝓚 𝓚').symm '' Set.sumEquiv.symm (B, B')
  let q'' := {t | Sum.inl ⁻¹' t ∈ insert Set.univ (insert ∅ q) ∧
    Sum.inr ⁻¹' t ∈ insert Set.univ (insert ∅ q')}
  refine ⟨q'', ?_, C, ?_, ?_⟩
  · exact IsCompactSystem.sum hq_compact.insert_empty.insert_univ
      hq'_compact.insert_empty.insert_univ
  · -- write `B = ⋂ k, A k` and `B' = ⋂ k, A' k`: then `C` is the intersection of the sets built
    -- from `A k` and `A' k` as `C` is built from `B` and `B'`
    unfold prodSigmaDelta at hB_prod hB'_prod
    simp_rw [mem_countableInfClosure_iff_iInf] at hB_prod hB'_prod
    choose A hA hB_eq using hB_prod
    choose A' hA' hB'_eq using hB'_prod
    have hC_eq : C = ⋂ k,
    (Equiv.prodSumDistrib 𝓧 𝓚 𝓚').symm '' Set.sumEquiv.symm (A k, A' k) := by
      simp only [C, ← hB_eq, ← hB'_eq]
      rw [← Set.image_iInter (Equiv.bijective _)]
      congr
      calc Set.sumEquiv.symm (⋂ n, A n, ⋂ n, A' n)
      _ = Set.sumEquiv.symm (⨅ n, (A n, A' n)) := by
        congr 1
        ext <;> simp [iInf, Prod.fst_sInf, Prod.snd_sInf]
      _ = ⨅ n, Set.sumEquiv.symm (A n, A' n) := OrderIso.map_iInf _ _
      _ = ⋂ i, Set.sumEquiv.symm (A i, A' i) := rfl
    rw [hC_eq]
    refine countableInfClosed_countableInfClosure.iInf_mem fun k ↦ subset_countableInfClosure ?_
    -- write `A k` and `A' k` as countable unions of products, and distribute
    simp_rw [mem_countableSupClosure_image2_prod_iff] at hA hA'
    choose B hB K hK hA_eq using hA
    choose B' hB' K' hK' hA'_eq using hA'
    simp_rw [← hA_eq, ← hA'_eq]
    have h_eq : (Equiv.prodSumDistrib 𝓧 𝓚 𝓚').symm '' Set.sumEquiv.symm
          (⋃ n, B k n ×ˢ K k n, ⋃ n, B' k n ×ˢ K' k n)
        = ⋃ n, (Equiv.prodSumDistrib 𝓧 𝓚 𝓚').symm '' Set.sumEquiv.symm
          (B k n ×ˢ K k n, B' k n ×ˢ K' k n) := by
      rw [← Set.image_iUnion]
      congr 1
      calc Set.sumEquiv.symm (⋃ n, B k n ×ˢ K k n, ⋃ n, B' k n ×ˢ K' k n)
      _ = Set.sumEquiv.symm (⨆ n, (B k n ×ˢ K k n, B' k n ×ˢ K' k n)) := by
        congr 1
        ext <;> simp [iSup, Prod.fst_sSup, Prod.snd_sSup]
      _ = ⨆ n, Set.sumEquiv.symm (B k n ×ˢ K k n, B' k n ×ˢ K' k n) := OrderIso.map_iSup _ _
      _ = ⋃ i, Set.sumEquiv.symm (B k i ×ˢ K k i, B' k i ×ˢ K' k i) := rfl
    rw [h_eq]
    refine countableSupClosed_countableSupClosure.iSup_mem fun i ↦ ?_
    simp only [Set.sumEquiv, OrderIso.symm_mk, RelIso.coe_fn_mk, Equiv.coe_fn_symm_mk]
    rw [Set.image_union]
    refine supClosed_countableSupClosure
      (subset_countableSupClosure ?_) (subset_countableSupClosure ?_)
    · refine ⟨B k i, hB _ _, Sum.inl '' (K k i), ?_, ?_⟩
      · simp only [Set.mem_ofPred_eq, q'']
        refine ⟨Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ ?_), by simp⟩
        convert hK k i
        ext
        simp
      · ext; simp [Equiv.prodSumDistrib]; grind
    · refine ⟨B' k i, hB' _ _, Sum.inr '' (K' k i), ?_, ?_⟩
      · simp only [Set.mem_ofPred_eq, q'']
        refine ⟨by simp, Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ ?_)⟩
        convert hK' k i
        ext
        simp
      · ext; simp [Equiv.prodSumDistrib]; grind
  · simp only [hB_eq, hB'_eq, C]
    ext
    simp [Equiv.prodSumDistrib, Equiv.sumProdDistrib, Set.sumEquiv]

/-- The union of two analytic sets is analytic. Theorem 1.26 of [he2019semimartingale]. -/
lemma IsPavingAnalytic.union {t : Set 𝓧}
    (hs : IsPavingAnalytic p s) (ht : IsPavingAnalytic p t) :
    IsPavingAnalytic p (s ∪ t) := by
  choose 𝓚 hs𝓚 using hs
  choose 𝓚' ht𝓚' using ht
  exact (IsPavingAnalyticFor.union hs𝓚 ht𝓚').isPavingAnalytic

lemma isPavingAnalyticFor_of_mem_countableInfClosure_of_imp {p' : Set (Set 𝓧)}
    (hs : s ∈ countableInfClosure p') (hqp : ∀ x, x ∈ p' → IsPavingAnalyticFor p 𝓚 x) :
    IsPavingAnalyticFor p (Π _ : ℕ, 𝓚) s := by
  rw [mem_countableInfClosure_iff_iInf] at hs
  obtain ⟨A, hA, rfl⟩ := hs
  exact IsPavingAnalyticFor.iInter fun n ↦ hqp _ (hA n)

lemma isPavingAnalytic_of_mem_countableInfClosure_of_imp {p' : Set (Set 𝓧)}
    (hs : s ∈ countableInfClosure p') (hqp : ∀ x, x ∈ p' → IsPavingAnalytic p x) :
    IsPavingAnalytic p s := by
  rw [mem_countableInfClosure_iff_iInf] at hs
  obtain ⟨A, hA, rfl⟩ := hs
  exact IsPavingAnalytic.iInter fun n ↦ hqp _ (hA n)

lemma isPavingAnalyticFor_of_mem_countableSupClosure_of_imp {p' : Set (Set 𝓧)}
    (hs : s ∈ countableSupClosure p') (hqp : ∀ x, x ∈ p' → IsPavingAnalyticFor p 𝓚 x) :
    IsPavingAnalyticFor p (Σ _ : ℕ, 𝓚) s := by
  rw [mem_countableSupClosure_iff_iSup] at hs
  obtain ⟨A, hA, rfl⟩ := hs
  exact IsPavingAnalyticFor.iUnion fun n ↦ hqp _ (hA n)

lemma isPavingAnalytic_of_mem_countableSupClosure_of_imp {p' : Set (Set 𝓧)}
    (hs : s ∈ countableSupClosure p') (hqp : ∀ x, x ∈ p' → IsPavingAnalytic p x) :
    IsPavingAnalytic p s := by
  rw [mem_countableSupClosure_iff_iSup] at hs
  obtain ⟨A, hA, rfl⟩ := hs
  exact IsPavingAnalytic.iUnion fun n ↦ hqp _ (hA n)

/-- The projection of an analytic set for the paving `p × q`, with `q` a compact system, is
analytic for `p`. This is Theorem 1.28 of [he2019semimartingale]. -/
lemma IsPavingAnalyticFor.fst (hq : IsCompactSystem q) {s : Set (𝓧 × 𝓚)}
    (hs : IsPavingAnalyticFor (Set.image2 (· ×ˢ ·) p q) 𝓚' s) :
    IsPavingAnalyticFor p (𝓚 × 𝓚') (Prod.fst '' s) := by
  obtain ⟨q', hq', B, hB, rfl⟩ := hs
  obtain ⟨C, hC, K', hK', rfl⟩ := mem_prodSigmaDelta_iff.mp hB
  choose A hA K hK hC_eq using hC
  refine ⟨Set.image2 (· ×ˢ ·) q q', hq.prod hq', ⋂ n, ⋃ m, A n m ×ˢ (K n m ×ˢ K' n m),
    mem_prodSigmaDelta_iff.mpr ⟨A, hA, _, fun n m ↦ Set.mem_image2_of_mem (hK n m) (hK' n m), rfl⟩,
    ?_⟩
  ext
  simp [← hC_eq, and_assoc]

/-- The projection of an analytic set for the paving `p × q`, with `q` a compact system, is
analytic for `p`. This is Theorem 1.28 of [he2019semimartingale]. -/
lemma IsPavingAnalytic.fst (hq : IsCompactSystem q)
    {s : Set (𝓧 × 𝓚)} (hs : IsPavingAnalytic (Set.image2 (· ×ˢ ·) p q) s) :
    IsPavingAnalytic p (Prod.fst '' s) := by
  obtain ⟨𝓚', hs𝓚'⟩ := hs
  exact (hs𝓚'.fst hq).isPavingAnalytic

/-- The product of an analytic set for `p` with a set of `r` is analytic for the product paving
`r × p`. -/
lemma IsPavingAnalyticFor.prod_left {r : Set (Set 𝓨)} {t : Set 𝓨} (ht : t ∈ r)
    (hs : IsPavingAnalyticFor p 𝓚 s) :
    IsPavingAnalyticFor (Set.image2 (· ×ˢ ·) r p) 𝓚 (t ×ˢ s) := by
  obtain ⟨q, hq, B, hB, rfl⟩ := hs
  obtain ⟨A, hA, K, hK, rfl⟩ := mem_prodSigmaDelta_iff.mp hB
  refine ⟨q, hq, ⋂ n, ⋃ m, (t ×ˢ A n m) ×ˢ K n m,
    mem_prodSigmaDelta_iff.mpr ⟨_, fun n m ↦ Set.mem_image2_of_mem ht (hA n m), K, hK, rfl⟩, ?_⟩
  ext ⟨y, x⟩
  simp only [Set.mem_prod, Set.mem_image, Set.mem_iInter, Set.mem_iUnion, Prod.exists,
    exists_and_right, exists_eq_right]
  exact ⟨fun ⟨hy, k, hk⟩ ↦ ⟨k, fun n ↦ (hk n).imp fun _ h ↦ ⟨⟨hy, h.1⟩, h.2⟩⟩,
    fun ⟨k, hk⟩ ↦ ⟨(hk 0).choose_spec.1.1, k, fun n ↦ (hk n).imp fun _ h ↦ ⟨h.1.2, h.2⟩⟩⟩

/-- The product of an analytic set for `p` with a set of `r` is analytic for the product paving
`r × p`. -/
lemma IsPavingAnalytic.prod_left {r : Set (Set 𝓨)} {t : Set 𝓨} (ht : t ∈ r)
    (hs : IsPavingAnalytic p s) :
    IsPavingAnalytic (Set.image2 (· ×ˢ ·) r p) (t ×ˢ s) :=
  let ⟨_, hs⟩ := hs
  (hs.prod_left ht).isPavingAnalytic

/-- The product of an analytic set for `p` with a set of `r` is analytic for the product paving
`p × r`. -/
lemma IsPavingAnalyticFor.prod_right {r : Set (Set 𝓨)} {t : Set 𝓨}
    (hs : IsPavingAnalyticFor p 𝓚 s) (ht : t ∈ r) :
    IsPavingAnalyticFor (Set.image2 (· ×ˢ ·) p r) 𝓚 (s ×ˢ t) := by
  obtain ⟨q, hq, B, hB, rfl⟩ := hs
  obtain ⟨A, hA, K, hK, rfl⟩ := mem_prodSigmaDelta_iff.mp hB
  refine ⟨q, hq, ⋂ n, ⋃ m, (A n m ×ˢ t) ×ˢ K n m,
    mem_prodSigmaDelta_iff.mpr ⟨_, fun n m ↦ Set.mem_image2_of_mem (hA n m) ht, K, hK, rfl⟩, ?_⟩
  ext ⟨x, y⟩
  simp only [Set.mem_prod, Set.mem_image, Set.mem_iInter, Set.mem_iUnion, Prod.exists,
    exists_and_right, exists_eq_right]
  exact ⟨fun ⟨⟨k, hk⟩, hy⟩ ↦ ⟨k, fun n ↦ (hk n).imp fun _ h ↦ ⟨⟨h.1, hy⟩, h.2⟩⟩,
    fun ⟨k, hk⟩ ↦ ⟨⟨k, fun n ↦ (hk n).imp fun _ h ↦ ⟨h.1.1, h.2⟩⟩, (hk 0).choose_spec.1.2⟩⟩

/-- The product of an analytic set for `p` with a set of `r` is analytic for the product paving
`p × r`. -/
lemma IsPavingAnalytic.prod_right {r : Set (Set 𝓨)} {t : Set 𝓨}
    (hs : IsPavingAnalytic p s) (ht : t ∈ r) :
    IsPavingAnalytic (Set.image2 (· ×ˢ ·) p r) (s ×ˢ t) :=
  let ⟨_, hs⟩ := hs
  (hs.prod_right ht).isPavingAnalytic

lemma isPavingAnalyticFor_of_image2_prod_isPavingAnalyticFor_left {𝓨 : Type*} {r : Set (Set 𝓨)}
    {t : Set (𝓨 × 𝓧)} (ht : t ∈ Set.image2 (· ×ˢ ·) r {s | IsPavingAnalyticFor p 𝓚 s}) :
    IsPavingAnalyticFor (Set.image2 (· ×ˢ ·) r p) 𝓚 t := by
  obtain ⟨A, hA, s, hs, rfl⟩ := ht
  exact hs.prod_left hA

lemma isPavingAnalytic_of_image2_prod_isPavingAnalytic_left {𝓨 : Type*} {r : Set (Set 𝓨)}
    {t : Set (𝓨 × 𝓧)} (ht : t ∈ Set.image2 (· ×ˢ ·) r {s | IsPavingAnalytic p s}) :
    IsPavingAnalytic (Set.image2 (· ×ˢ ·) r p) t := by
  obtain ⟨A, hA, s, hs, rfl⟩ := ht
  exact hs.prod_left hA

lemma isPavingAnalyticFor_of_image2_prod_isPavingAnalyticFor_right {𝓨 : Type*} {r : Set (Set 𝓨)}
    {t : Set (𝓧 × 𝓨)} (ht : t ∈ Set.image2 (· ×ˢ ·) {s | IsPavingAnalyticFor p 𝓚 s} r) :
    IsPavingAnalyticFor (Set.image2 (· ×ˢ ·) p r) 𝓚 t := by
  obtain ⟨A, hA, s, hs, rfl⟩ := ht
  exact hA.prod_right hs

lemma isPavingAnalytic_of_image2_prod_isPavingAnalytic_right {𝓨 : Type*} {r : Set (Set 𝓨)}
    {t : Set (𝓧 × 𝓨)} (ht : t ∈ Set.image2 (· ×ˢ ·) {s | IsPavingAnalytic p s} r) :
    IsPavingAnalytic (Set.image2 (· ×ˢ ·) p r) t := by
  obtain ⟨A, hA, s, hs, rfl⟩ := ht
  exact hA.prod_right hs

lemma isPavingAnalyticFor_of_mem_countableSupClosure_image2_prod_isPavingAnalyticFor_left
    {𝓨 : Type*} {r : Set (Set 𝓨)} {t : Set (𝓨 × 𝓧)}
    (ht : t ∈ countableSupClosure (Set.image2 (· ×ˢ ·) r {s | IsPavingAnalyticFor p 𝓚 s})) :
    IsPavingAnalyticFor (Set.image2 (· ×ˢ ·) r p) (Σ _ : ℕ, 𝓚) t := by
  refine isPavingAnalyticFor_of_mem_countableSupClosure_of_imp
    (p' := Set.image2 (· ×ˢ ·) r {s | IsPavingAnalyticFor p 𝓚 s}) ht fun s hs ↦ ?_
  exact isPavingAnalyticFor_of_image2_prod_isPavingAnalyticFor_left hs

lemma isPavingAnalyticFor_of_mem_countableSupClosure_image2_prod_isPavingAnalyticFor_right
    {𝓨 : Type*} {r : Set (Set 𝓨)} {t : Set (𝓧 × 𝓨)}
    (ht : t ∈ countableSupClosure (Set.image2 (· ×ˢ ·) {s | IsPavingAnalyticFor p 𝓚 s} r)) :
    IsPavingAnalyticFor (Set.image2 (· ×ˢ ·) p r) (Σ _ : ℕ, 𝓚) t := by
  refine isPavingAnalyticFor_of_mem_countableSupClosure_of_imp
    (p' := Set.image2 (· ×ˢ ·) {s | IsPavingAnalyticFor p 𝓚 s} r) ht fun s hs ↦ ?_
  exact isPavingAnalyticFor_of_image2_prod_isPavingAnalyticFor_right hs

lemma IsPavingAnalyticFor.prod_mem_countableSupClosure_left {𝓨 : Type*} {r : Set (Set 𝓨)}
    {t : Set 𝓨} (ht : t ∈ countableSupClosure r) (hs : IsPavingAnalyticFor p 𝓚 s) :
    IsPavingAnalyticFor (Set.image2 (· ×ˢ ·) r p) (Σ _ : ℕ, 𝓚) (t ×ˢ s) := by
  refine isPavingAnalyticFor_of_mem_countableSupClosure_image2_prod_isPavingAnalyticFor_left ?_
  rw [mem_countableSupClosure_iff_iSup] at ht ⊢
  obtain ⟨A, hA, rfl⟩ := ht
  refine ⟨fun n ↦ A n ×ˢ s, fun n ↦ ⟨A n, hA n, s, hs, rfl⟩, ?_⟩
  simp only [Set.iSup_eq_iUnion]
  rw [Set.iUnion_prod_const]

lemma IsPavingAnalyticFor.prod_mem_countableSupClosure_right {𝓨 : Type*} {r : Set (Set 𝓨)}
    {t : Set 𝓨} (hs : IsPavingAnalyticFor p 𝓚 s) (ht : t ∈ countableSupClosure r) :
    IsPavingAnalyticFor (Set.image2 (· ×ˢ ·) p r) (Σ _ : ℕ, 𝓚) (s ×ˢ t) := by
  refine isPavingAnalyticFor_of_mem_countableSupClosure_image2_prod_isPavingAnalyticFor_right ?_
  rw [mem_countableSupClosure_iff_iSup] at ht ⊢
  obtain ⟨A, hA, rfl⟩ := ht
  refine ⟨fun n ↦ s ×ˢ A n, fun n ↦ ⟨s, hs, A n, hA n, rfl⟩, ?_⟩
  simp only [Set.iSup_eq_iUnion]
  rw [Set.prod_iUnion]

/-- The product of two analytic sets is analytic for the product paving. Theorem 1.27 of
[he2019semimartingale]. -/
lemma IsPavingAnalyticFor.prod {𝓨 𝓚' : Type*} {r : Set (Set 𝓨)} {t : Set 𝓨}
    (ht : IsPavingAnalyticFor r 𝓚' t) (hs : IsPavingAnalyticFor p 𝓚 s) :
    IsPavingAnalyticFor (Set.image2 (· ×ˢ ·) r p) ((Σ _ : ℕ, 𝓚') × (Σ _ : ℕ, 𝓚)) (t ×ˢ s) := by
  obtain ⟨t₁, ht₁, ht₁_subset⟩ := ht.exists_mem_countableSupClosure_superset
  obtain ⟨s₁, hs₁, hs₁_subset⟩ := hs.exists_mem_countableSupClosure_superset
  have h_eq : t ×ˢ s = (t ×ˢ s₁) ∩ (t₁ ×ˢ s) := by ext; simp; grind
  rw [h_eq]
  refine IsPavingAnalyticFor.inter ?_ ?_
  · exact ht.prod_mem_countableSupClosure_right hs₁
  · exact hs.prod_mem_countableSupClosure_left ht₁

/-- The product of two analytic sets is analytic for the product paving. Theorem 1.27 of
[he2019semimartingale]. -/
lemma IsPavingAnalytic.prod {𝓨 : Type*} {r : Set (Set 𝓨)} {t : Set 𝓨}
    (ht : IsPavingAnalytic r t) (hs : IsPavingAnalytic p s) :
    IsPavingAnalytic (Set.image2 (· ×ˢ ·) r p) (t ×ˢ s) := by
  obtain ⟨𝓚', ht'⟩ := ht
  obtain ⟨𝓚, hs'⟩ := hs
  exact (IsPavingAnalyticFor.prod ht' hs').isPavingAnalytic

/-- The image of an analytic set by an injective map is analytic for the image paving. -/
lemma IsPavingAnalyticFor.image_of_injective {f : 𝓧 → 𝓨} (hf : Function.Injective f)
    (hs : IsPavingAnalyticFor p 𝓚 s) :
    IsPavingAnalyticFor ((f '' ·) '' p) 𝓚 (f '' s) := by
  obtain ⟨q, hq, t, ht, rfl⟩ := hs
  refine ⟨q, hq, Prod.map f id '' t, ?_, by rw [Set.image_image, Set.image_image]; rfl⟩
  rw [mem_prodSigmaDelta_iff] at ht ⊢
  obtain ⟨A, hA, K, hK, rfl⟩ := ht
  refine ⟨fun n m ↦ f '' A n m, fun n m ↦ ⟨A n m, hA n m, rfl⟩, K, hK, ?_⟩
  rw [(hf.prodMap Function.injective_id).injOn.image_iInter_eq]
  simp_rw [Set.image_iUnion, Set.prodMap_image_prod, Set.image_id]

/-- The image of an analytic set by an injective map is analytic for the image paving. -/
lemma IsPavingAnalytic.image_of_injective {f : 𝓧 → 𝓨} (hf : Function.Injective f)
    (hs : IsPavingAnalytic p s) :
    IsPavingAnalytic ((f '' ·) '' p) (f '' s) := by
  obtain ⟨𝓚, hs⟩ := hs
  exact (hs.image_of_injective hf).isPavingAnalytic

/-- The image of a set that is analytic for the paving of measurable sets by a measurable
embedding is analytic for the paving of measurable sets. -/
lemma IsPavingAnalytic.image_measurableEmbedding {m𝓧 : MeasurableSpace 𝓧}
    {m𝓨 : MeasurableSpace 𝓨} {f : 𝓧 → 𝓨} (hf : MeasurableEmbedding f)
    (hs : IsPavingAnalytic {t | MeasurableSet t} s) :
    IsPavingAnalytic {t | MeasurableSet t} (f '' s) := by
  refine (hs.image_of_injective hf.injective).mono ?_
  rintro _ ⟨u, hu, rfl⟩
  exact hf.measurableSet_image' hu

lemma IsPavingAnalytic.image_swap {m𝓧 : MeasurableSpace 𝓧} {m𝓨 : MeasurableSpace 𝓨}
    {s : Set (𝓧 × 𝓨)} (hs : IsPavingAnalytic {t | MeasurableSet t} s) :
    IsPavingAnalytic {t | MeasurableSet t} (Prod.swap '' s) :=
  hs.image_measurableEmbedding MeasurableEquiv.prodComm.measurableEmbedding

/-- A set that is analytic for the paving of analytic sets is analytic. Theorem 1.29 of
[he2019semimartingale]. -/
lemma isPavingAnalyticFor_isPavingAnalyticFor
    (hs : IsPavingAnalyticFor {t | IsPavingAnalyticFor p 𝓚 t} 𝓚 s) :
    IsPavingAnalyticFor p (𝓚 × (ℕ → (_ : ℕ) × 𝓚)) s := by
  obtain ⟨q, hq, t, ht, rfl⟩ := hs
  suffices IsPavingAnalyticFor (Set.image2 (· ×ˢ ·) p q) (ℕ → (_ : ℕ) × 𝓚) t by
    exact this.fst hq
  refine isPavingAnalyticFor_of_mem_countableInfClosure_of_imp ht fun t ht ↦ ?_
  refine isPavingAnalyticFor_of_mem_countableSupClosure_of_imp ht fun t ht ↦ ?_
  exact isPavingAnalyticFor_of_image2_prod_isPavingAnalyticFor_right ht

/-- A set that is analytic for the paving of analytic sets is analytic. Theorem 1.29 of
[he2019semimartingale]. -/
lemma isPavingAnalytic_isPavingAnalytic (hs : IsPavingAnalytic {t | IsPavingAnalytic p t} s) :
    IsPavingAnalytic p s := by
  obtain ⟨𝓚, hs'⟩ := hs
  obtain ⟨q, hq, t, ht, rfl⟩ := hs'
  suffices IsPavingAnalytic (Set.image2 (· ×ˢ ·) p q) t from this.fst hq
  refine isPavingAnalytic_of_mem_countableInfClosure_of_imp ht fun t ht ↦ ?_
  refine isPavingAnalytic_of_mem_countableSupClosure_of_imp ht fun t ht ↦ ?_
  exact isPavingAnalytic_of_image2_prod_isPavingAnalytic_right ht

/-- A set is analytic for the paving of analytic sets if and only if it is analytic. -/
@[simp]
lemma isPavingAnalytic_isPavingAnalytic_iff :
    IsPavingAnalytic {t | IsPavingAnalytic p t} s ↔ IsPavingAnalytic p s :=
  ⟨isPavingAnalytic_isPavingAnalytic, fun hs ↦ isPavingAnalytic_of_mem hs⟩

/-- If `s` is analytic for `p`, then `s ∩ t` is analytic for the trace of `p` on `t`. Theorem 1.30
of [he2019semimartingale]. -/
lemma IsPavingAnalyticFor.inter_set (hs : IsPavingAnalyticFor p 𝓚 s) (t : Set 𝓧) :
    IsPavingAnalyticFor {u | ∃ v, v ∈ p ∧ u = v ∩ t} 𝓚 (s ∩ t) := by
  obtain ⟨q, hq, A, hA, rfl⟩ := hs
  let A' := (t ×ˢ .univ) ∩ A
  refine ⟨q, hq, A', ?_, by ext; simp; grind⟩
  simp_rw [mem_prodSigmaDelta_iff] at hA ⊢
  obtain ⟨B, hB, K, hK, rfl⟩ := hA
  refine ⟨fun n m ↦ B n m ∩ t, fun n m ↦ ⟨B n m, hB n m, rfl⟩, K, hK, ?_⟩
  simp only [A']
  simp_rw [Set.inter_iInter, Set.inter_iUnion]
  congr with
  simp
  grind

/-- A set that is analytic for the trace of `p` on `t` is the intersection with `t` of a set that is
analytic for `p`. Theorem 1.30 of [he2019semimartingale]. -/
lemma exists_isPavingAnalyticFor_of_inter_set (t : Set 𝓧)
    (hs : IsPavingAnalyticFor {u | ∃ v, v ∈ p ∧ u = v ∩ t} 𝓚 s) :
    ∃ s', IsPavingAnalyticFor p 𝓚 s' ∧ s = s' ∩ t := by
  obtain ⟨q, hq, A, hA, rfl⟩ := hs
  rw [mem_prodSigmaDelta_iff] at hA
  obtain ⟨B, hB, K, hK, rfl⟩ := hA
  choose A' hA' hBA' using hB
  refine ⟨Prod.fst '' (⋂ n, ⋃ m, A' n m ×ˢ K n m), ?_, ?_⟩
  · refine ⟨q, hq, ?_⟩
    refine ⟨⋂ n, ⋃ m, A' n m ×ˢ K n m, ?_, rfl⟩
    rw [mem_prodSigmaDelta_iff]
    exact ⟨A', hA', K, hK, rfl⟩
  · simp only [hBA']
    have h_eq n m : (A' n m ∩ t) ×ˢ K n m = (A' n m ×ˢ K n m) ∩ (t ×ˢ .univ) := by
      ext; simp; grind
    simp_rw [h_eq, ← Set.iUnion_inter, ← Set.iInter_inter]
    suffices h_eq' : ∀ (s : Set (𝓧 × 𝓚)), Prod.fst '' (s ∩ (t ×ˢ .univ)) = Prod.fst '' s ∩ t by
      rw [h_eq']
    intro s
    ext s
    simp

/-- If the complement of every set of `p` is analytic for `p`, then every set of the σ-algebra
generated by `p` is analytic for `p`. This is Theorem 1.31 of [he2019semimartingale]. -/
lemma isPavingAnalytic_of_measurableSet_generateFrom (hp_nonempty : p.Nonempty)
    (hp : ∀ s, s ∈ p → IsPavingAnalytic p sᶜ)
    (hs : MeasurableSet[MeasurableSpace.generateFrom p] s) :
    IsPavingAnalytic p s := by
  let G : Set (Set 𝓧) := {t | IsPavingAnalytic p t ∧ IsPavingAnalytic p tᶜ}
  suffices s ∈ G by
    simp only [Set.mem_ofPred_eq, G] at this
    exact this.1
  have hsG : MeasurableSet[MeasurableSpace.generateFrom G] s := by
    have h_subset : p ⊆ G := by
      intro t ht
      simp only [Set.mem_ofPred_eq, G]
      exact ⟨isPavingAnalytic_of_mem ht, hp t ht⟩
    have h_mono := MeasurableSpace.generateFrom_mono h_subset
    exact h_mono s hs
  refine MeasurableSpace.induction_on_inter (s := G) (C := fun s hs ↦ s ∈ G) ?_ ?_ ?_ ?_ ?_ ?_ s hsG
  · rfl
  · intro s hs t ht hst
    simp only [Set.mem_ofPred_eq, G] at hs ht ⊢
    rw [Set.compl_inter]
    exact ⟨hs.1.inter ht.1, hs.2.union ht.2⟩
  · simp only [Set.mem_ofPred_eq, Set.compl_empty, G]
    obtain ⟨u, hu⟩ := hp_nonempty
    refine ⟨isPavingAnalytic_empty ⟨u, hu⟩, ?_⟩
    rw [← Set.union_compl_self u]
    exact (isPavingAnalytic_of_mem hu).union (hp u hu)
  · exact fun _ ↦ id
  · simp only [Set.mem_ofPred_eq, compl_compl, and_imp, G]
    intro t _ ht htc
    exact ⟨htc, ht⟩
  · intro f hf_disj hf_meas hfG
    simp only [Set.mem_ofPred_eq, Set.compl_iUnion, G] at hfG ⊢
    exact ⟨IsPavingAnalytic.iUnion fun n ↦ (hfG n).1,
      IsPavingAnalytic.iInter fun n ↦ (hfG n).2⟩

lemma Iic_mem_countableSupClosure_Icc {ι : Type*}
    [LinearOrder ι] [TopologicalSpace ι] [SecondCountableTopology ι] [OrderTopology ι]
    (u : ι) :
    Set.Iic u ∈ countableSupClosure {t | ∃ a b, Set.Icc a b = t} := by
  have : Nonempty ι := ⟨u⟩
  by_cases h_bot : ∃ x : ι, IsBot x
  · obtain ⟨x, hx_bot⟩ := h_bot
    refine subset_countableSupClosure ⟨x, u, ?_⟩
    ext y
    simp only [Set.mem_Icc, Set.mem_Iic, and_iff_right_iff_imp]
    exact fun _ ↦ hx_bot y
  obtain ⟨u₁, hu₁_anti, hu₁_tendsto⟩ := Filter.exists_seq_antitone_tendsto_atTop_atBot ι
  rw [mem_countableSupClosure_iff_iSup]
  refine ⟨fun n ↦ Set.Icc (u₁ n) u, fun n ↦ ⟨u₁ n, u, rfl⟩, ?_⟩
  ext x
  simp only [Set.iSup_eq_iUnion, Set.mem_iUnion, Set.mem_Icc, exists_and_right, Set.mem_Iic,
    and_iff_right_iff_imp]
  intro hxu
  exact (hu₁_tendsto.eventually_le_atBot x).exists

lemma Ici_mem_countableSupClosure_Icc {ι : Type*}
    [LinearOrder ι] [TopologicalSpace ι] [SecondCountableTopology ι] [OrderTopology ι]
    (u : ι) :
    Set.Ici u ∈ countableSupClosure {t | ∃ a b, Set.Icc a b = t} := by
  have : Nonempty ι := ⟨u⟩
  by_cases h_top : ∃ x : ι, IsTop x
  · obtain ⟨x, hx_top⟩ := h_top
    refine subset_countableSupClosure ⟨u, x, ?_⟩
    ext y
    simp only [Set.mem_Icc, Set.mem_Ici, and_iff_left_iff_imp]
    exact fun _ ↦ hx_top y
  obtain ⟨u₁, hu₁_anti, hu₁_tendsto⟩ := Filter.exists_seq_monotone_tendsto_atTop_atTop ι
  rw [mem_countableSupClosure_iff_iSup]
  refine ⟨fun n ↦ Set.Icc u (u₁ n), fun n ↦ ⟨u, u₁ n, rfl⟩, ?_⟩
  ext x
  simp only [Set.iSup_eq_iUnion, Set.mem_iUnion, Set.mem_Icc, exists_and_left, Set.mem_Ici,
    and_iff_left_iff_imp]
  intro hxu
  exact (hu₁_tendsto.eventually_ge_atTop x).exists

lemma Iio_mem_countableSupClosure_Icc {ι : Type*}
    [LinearOrder ι] [TopologicalSpace ι] [SecondCountableTopology ι] [OrderTopology ι]
    (u : ι) :
    Set.Iio u ∈ countableSupClosure (insert ∅ {t | ∃ a b, Set.Icc a b = t}) := by
  have h_mono := countableSupClosure_mono (Set.subset_insert ∅ {t | ∃ a b : ι, Set.Icc a b = t})
  by_cases hu : 𝓝[<] u = ⊥
  · -- `u` is the bottom element, or has a predecessor `v` and `Iio u = Iic v`
    rcases nhdsLT_eq_bot_iff.mp hu with hu | ⟨v, hvu⟩
    · rw [Set.Iio_eq_empty_iff.mpr hu.isMin]
      exact subset_countableSupClosure (Set.mem_insert _ _)
    · rw [hvu.Iio_eq]
      exact h_mono (Iic_mem_countableSupClosure_Icc v)
  -- `u` is a limit from the left: `Iio u` is the union of `Iic (s n)` for `s n < u` tending to `u`
  obtain ⟨s, hs_lt, hs_tendsto⟩ :=
    mem_closure_iff_seq_limit.mp (mem_closure_iff_nhdsWithin_neBot.mpr ⟨hu⟩)
  have : Set.Iio u = ⋃ n, Set.Iic (s n) := by
    ext x
    simp only [Set.mem_Iio, Set.mem_iUnion, Set.mem_Iic]
    refine ⟨fun hxu ↦ ?_, fun ⟨i, hi⟩ ↦ hi.trans_lt (hs_lt i)⟩
    exact ((hs_tendsto.eventually_const_lt hxu).mono fun _ h ↦ h.le).exists
  rw [this]
  exact h_mono (countableSupClosed_countableSupClosure.iSup_mem
    fun n ↦ Iic_mem_countableSupClosure_Icc (s n))

lemma Ioi_mem_countableSupClosure_Icc {ι : Type*}
    [LinearOrder ι] [TopologicalSpace ι] [SecondCountableTopology ι] [OrderTopology ι]
    (u : ι) :
    Set.Ioi u ∈ countableSupClosure (insert ∅ {t | ∃ a b, Set.Icc a b = t}) := by
  have h_mono := countableSupClosure_mono (Set.subset_insert ∅ {t | ∃ a b : ι, Set.Icc a b = t})
  by_cases hu : 𝓝[>] u = ⊥
  · -- `u` is the top element, or has a successor `v` and `Ioi u = Ici v`
    rcases nhdsGT_eq_bot_iff.mp hu with hu | ⟨v, huv⟩
    · rw [Set.Ioi_eq_empty_iff.mpr hu.isMax]
      exact subset_countableSupClosure (Set.mem_insert _ _)
    · rw [huv.Ioi_eq]
      exact h_mono (Ici_mem_countableSupClosure_Icc v)
  -- `u` is a limit from the right: `Ioi u` is the union of `Ici (s n)` for `u < s n` tending to `u`
  obtain ⟨s, hs_gt, hs_tendsto⟩ :=
    mem_closure_iff_seq_limit.mp (mem_closure_iff_nhdsWithin_neBot.mpr ⟨hu⟩)
  have : Set.Ioi u = ⋃ n, Set.Ici (s n) := by
    ext x
    simp only [Set.mem_Ioi, Set.mem_iUnion, Set.mem_Ici]
    refine ⟨fun hxu ↦ ?_, fun ⟨i, hi⟩ ↦ (hs_gt i).trans_le hi⟩
    exact ((hs_tendsto.eventually_lt_const hxu).mono fun _ h ↦ h.le).exists
  rw [this]
  exact h_mono (countableSupClosed_countableSupClosure.iSup_mem
    fun n ↦ Ici_mem_countableSupClosure_Icc (s n))

lemma univ_mem_countableSupClosure_Icc {ι : Type*} [hι : Nonempty ι]
    [LinearOrder ι] [TopologicalSpace ι] [SecondCountableTopology ι] [OrderTopology ι] :
    (Set.univ : Set ι) ∈ countableSupClosure {t | ∃ a b, Set.Icc a b = t} := by
  obtain x : ι := hι.some
  have : (Set.univ : Set ι) = Set.Iic x ∪ Set.Ici x := by ext; simp
  rw [this]
  exact supClosed_countableSupClosure (Iic_mem_countableSupClosure_Icc x)
    (Ici_mem_countableSupClosure_Icc x)

lemma compl_Icc_mem_countableSupClosure_Icc {ι : Type*}
    [LinearOrder ι] [TopologicalSpace ι] [SecondCountableTopology ι]
    [OrderTopology ι] (l u : ι) :
    (Set.Icc l u)ᶜ ∈ countableSupClosure (insert ∅ {t | ∃ a b, Set.Icc a b = t}) := by
  have : Nonempty ι := ⟨l⟩
  rcases lt_or_ge u l with hlu | hlu
  · simp only [not_le, hlu, Set.Icc_eq_empty, Set.compl_empty]
    exact (countableSupClosure_mono fun s hs ↦ Set.mem_insert_of_mem _ hs)
      univ_mem_countableSupClosure_Icc
  · have : (Set.Icc l u)ᶜ = Set.Iio l ∪ Set.Ioi u := by ext; simp; grind
    rw [this]
    exact supClosed_countableSupClosure (Iio_mem_countableSupClosure_Icc l)
      (Ioi_mem_countableSupClosure_Icc u)

lemma compl_mem_countableSupClosure_image2_prod_Icc {ι : Type*} [Nonempty ι]
    [LinearOrder ι] [TopologicalSpace ι] [SecondCountableTopology ι]
    [OrderTopology ι] [MeasurableSpace 𝓧] (s : Set (𝓧 × ι))
    (hs : s ∈ Set.image2 (· ×ˢ ·) {t | MeasurableSet t} (insert ∅ {t | ∃ a b, Set.Icc a b = t})) :
     sᶜ ∈ countableSupClosure
       (Set.image2 (· ×ˢ ·) {t | MeasurableSet t} (insert ∅ {t | ∃ a b, Set.Icc a b = t})) := by
  obtain ⟨A, hA, K, hK_eq, rfl⟩ := hs
  simp only [Set.mem_insert_iff, Set.mem_ofPred_eq] at hK_eq
  cases hK_eq with
  | inl hK_eq =>
    simp only [hK_eq, Set.prod_empty, Set.compl_empty]
    refine (countableSupClosure_mono
      (a := Set.image2 (· ×ˢ ·) {t | MeasurableSet t} {t | ∃ a b : ι, Set.Icc a b = t}) ?_) ?_
    · exact Set.image2_subset_left (Set.subset_insert _ _)
    have h_mem_sigma := univ_mem_countableSupClosure_Icc (ι := ι)
    rw [mem_countableSupClosure_iff_iSup] at h_mem_sigma ⊢
    obtain ⟨B, hB, h_eq⟩ := h_mem_sigma
    have h_univ_prod : (Set.univ : Set 𝓧) ×ˢ (Set.univ : Set ι) = Set.univ := by simp
    rw [← h_univ_prod, ← h_eq, Set.iSup_eq_iUnion, Set.prod_iUnion]
    refine ⟨fun i ↦ Set.univ ×ˢ B i, fun n ↦ ?_, rfl⟩
    exact ⟨Set.univ, MeasurableSet.univ, B n, hB n, rfl⟩
  | inr hK_eq =>
    obtain ⟨l, u, rfl⟩ := hK_eq
    rw [Set.compl_prod_eq_union]
    refine supClosed_countableSupClosure ?_ ?_
    · have h := univ_mem_countableSupClosure_Icc (ι := ι)
      rw [mem_countableSupClosure_iff_iSup] at h ⊢
      obtain ⟨B, hB, h_eq⟩ := h
      rw [← h_eq, Set.iSup_eq_iUnion, Set.prod_iUnion]
      refine ⟨fun i ↦ Aᶜ ×ˢ B i, fun n ↦ ?_, rfl⟩
      exact ⟨Aᶜ, hA.compl, B n, Set.mem_insert_of_mem _ (hB n), rfl⟩
    · have h := compl_Icc_mem_countableSupClosure_Icc l u
      rw [mem_countableSupClosure_iff_iSup] at h ⊢
      obtain ⟨B, hB, h_eq⟩ := h
      rw [← h_eq, Set.iSup_eq_iUnion, Set.prod_iUnion]
      refine ⟨fun i ↦ Set.univ ×ˢ B i, fun n ↦ ?_, rfl⟩
      exact ⟨Set.univ, MeasurableSet.univ, B n, hB n, rfl⟩

/-- A measurable set of a second countable linear order is analytic for the paving of closed
intervals. Variant of Theorem 1.32 (1) of [he2019semimartingale]. -/
lemma _root_.MeasurableSet.isPavingAnalytic_Icc {ι : Type*} {mι : MeasurableSpace ι}
    [LinearOrder ι] [TopologicalSpace ι] [SecondCountableTopology ι]
    [OrderTopology ι] [BorelSpace ι]
    {s : Set ι} (hs : MeasurableSet s) :
    IsPavingAnalytic (insert ∅ {t | ∃ a b, Set.Icc a b = t}) s := by
  by_cases! h_lt : ∃ l u : ι, l < u
  swap
  · rcases isEmpty_or_nonempty ι with h_empty | h_nonempty
    · simp only [IsEmpty.exists_iff, Set.ofPred_false, insert_empty_eq]
      refine isPavingAnalytic_of_mem ?_
      simp [Set.eq_empty_of_isEmpty s]
    · obtain ⟨x⟩ := h_nonempty
      have : Subsingleton ι := ⟨fun y z ↦ le_antisymm (h_lt z y) (h_lt y z)⟩
      have : {t | ∃ a b, Set.Icc a b = t} = {{x}} := by
        refine subset_antisymm ?_ ?_
        · rintro _ ⟨l, u, rfl⟩
          simp [Subsingleton.elim _ x]
        · intro s
          simp only [Set.mem_singleton_iff, Set.mem_ofPred_eq]
          rintro rfl
          exact ⟨x, x, by simp⟩
      simp only [this]
      refine isPavingAnalytic_of_mem ?_
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
      by_cases hxs : x ∈ s
      · right; ext; simp [hxs, Subsingleton.elim _ x]
      · left; ext; simp [hxs, Subsingleton.elim _ x]
  obtain ⟨l₀, u₀, hlu₀⟩ := h_lt
  have : Nonempty ι := ⟨l₀⟩
  have hmι : mι = borel ι := BorelSpace.measurable_eq
  have hs' : MeasurableSet[MeasurableSpace.generateFrom
      (insert ∅ {t | ∃ a b, Set.Icc a b = t})] s := by
    rwa [hmι, borel_eq_generateFrom_insert_empty_Icc] at hs
  refine isPavingAnalytic_of_measurableSet_generateFrom ⟨∅, by simp⟩ ?_ hs'
  · intro s hs
    refine isPavingAnalytic_of_mem_countableSupClosure_of_imp
      (p' := insert ∅ {t | ∃ a b, Set.Icc a b = t}) ?_ (fun K hK ↦ isPavingAnalytic_of_mem hK)
    simp only [Set.mem_insert_iff, Set.mem_ofPred_eq] at hs
    cases hs with
    | inl h =>
      simp only [h, Set.compl_empty]
      exact (countableSupClosure_mono fun s hs ↦ Set.mem_insert_of_mem _ hs)
        univ_mem_countableSupClosure_Icc
    | inr h =>
      obtain ⟨l, u, rfl⟩ := h
      exact compl_Icc_mem_countableSupClosure_Icc l u

/-- In a second countable linear order, a set is analytic for the paving of measurable sets if and
only if it is analytic for the paving of closed intervals. -/
lemma isPavingAnalytic_measurableSet_iff_isPavingAnalytic_Icc {ι : Type*} {mι : MeasurableSpace ι}
    [LinearOrder ι] [TopologicalSpace ι] [SecondCountableTopology ι]
    [OrderTopology ι] [BorelSpace ι]
    (s : Set ι) :
    IsPavingAnalytic {t | MeasurableSet t} s ↔
      IsPavingAnalytic (insert ∅ {t | ∃ a b, Set.Icc a b = t}) s := by
  refine ⟨fun hs ↦ ?_, fun hs ↦ ?_⟩
  · rw [← isPavingAnalytic_isPavingAnalytic_iff]
    exact hs.mono fun s hs ↦ MeasurableSet.isPavingAnalytic_Icc hs
  · refine hs.mono fun s hs ↦ ?_
    simp only [Set.mem_insert_iff, Set.mem_ofPred_eq] at hs
    cases hs with
    | inl h => simp [h]
    | inr h =>
      obtain ⟨l, u, rfl⟩ := h
      simp

lemma isCountablySpanning_insert_empty_Icc {ι : Type*} [Nonempty ι]
    [LinearOrder ι] [TopologicalSpace ι] [SecondCountableTopology ι] [OrderTopology ι] :
    IsCountablySpanning (insert ∅ {t | ∃ a b : ι, Set.Icc a b = t}) := by
  have h := univ_mem_countableSupClosure_Icc (ι := ι)
  rw [mem_countableSupClosure_iff_iSup] at h
  obtain ⟨A, hA, h_eq⟩ := h
  exact ⟨A, fun n ↦ Set.mem_insert_of_mem _ (hA n), h_eq⟩

/-- A measurable set of `𝓧 × ι` is analytic for the product of the paving of measurable sets and
the paving of closed intervals. Variant of Theorem 1.32 (2) of [he2019semimartingale]. -/
lemma _root_.MeasurableSet.isPavingAnalytic_image2_prod {ι : Type*} {mι : MeasurableSpace ι}
    [LinearOrder ι] [TopologicalSpace ι] [SecondCountableTopology ι]
    [OrderTopology ι] [BorelSpace ι]
    {s : Set (𝓧 × ι)} {m𝓧 : MeasurableSpace 𝓧}
    (hs : MeasurableSet s) :
    IsPavingAnalytic (Set.image2 (· ×ˢ ·) {t | MeasurableSet t}
      (insert ∅ {t | ∃ a b, Set.Icc a b = t})) s := by
  have h_nonempty : (Set.image2 (· ×ˢ ·) {t : Set 𝓧 | MeasurableSet t}
      (insert ∅ {t | ∃ a b : ι, Set.Icc a b = t})).Nonempty :=
    ⟨∅, ∅, MeasurableSet.empty, ∅, by simp, by simp⟩
  rcases isEmpty_or_nonempty ι with hι | hι
  · rw [Set.eq_empty_of_isEmpty s]
    exact isPavingAnalytic_empty h_nonempty
  have h_compl (t : Set (𝓧 × ι))
        (ht : t ∈ Set.image2 (· ×ˢ ·) {t | MeasurableSet t}
          (insert ∅ {t | ∃ a b, Set.Icc a b = t})) :
      IsPavingAnalytic (Set.image2 (· ×ˢ ·) {t | MeasurableSet t}
        (insert ∅ {t | ∃ a b, Set.Icc a b = t})) tᶜ :=
    isPavingAnalytic_of_mem_countableSupClosure_of_imp
      (compl_mem_countableSupClosure_image2_prod_Icc _ ht)
      fun s hs ↦ isPavingAnalytic_of_mem hs
  refine isPavingAnalytic_of_measurableSet_generateFrom h_nonempty h_compl ?_
  · convert hs
    have h_prod_eq := generateFrom_eq_prod (α := 𝓧) (β := ι)
      (C := {t : Set 𝓧 | MeasurableSet t})
      (D := insert ∅ {t | ∃ a b, Set.Icc a b = t}) MeasurableSpace.generateFrom_measurableSet ?_
      isCountablySpanning_measurableSet isCountablySpanning_insert_empty_Icc
    swap
    · have : mι = borel ι := BorelSpace.measurable_eq
      rw [this, borel_eq_generateFrom_insert_empty_Icc]
    rw [← h_prod_eq]

/-- A set of `𝓧 × ι` is analytic for the paving of measurable sets if and only if it is analytic
for the product of the paving of measurable sets and the paving of closed intervals. Variant of
Theorem 1.32 (2) of [he2019semimartingale]. -/
lemma isPavingAnalytic_image2_prod_measurableSet_Icc_iff {ι : Type*} {mι : MeasurableSpace ι}
    [LinearOrder ι] [TopologicalSpace ι] [SecondCountableTopology ι]
    [OrderTopology ι] [BorelSpace ι]
    {s : Set (𝓧 × ι)} [MeasurableSpace 𝓧] :
    IsPavingAnalytic (Set.image2 (· ×ˢ ·) {t | MeasurableSet t}
        (insert ∅ {t | ∃ a b, Set.Icc a b = t})) s ↔
      IsPavingAnalytic {t | MeasurableSet t} s := by
  refine ⟨fun hs ↦ hs.mono fun s hs ↦ ?_, fun hs ↦ ?_⟩
  · obtain ⟨A, hA, K, hK, rfl⟩ := hs
    cases hK with
    | inl h =>
      simp only [h, Set.prod_empty]
      exact (MeasurableSet.empty : MeasurableSet (∅ : Set (𝓧 × ι)))
    | inr h =>
      obtain ⟨l, u, rfl⟩ := h
      exact hA.prod measurableSet_Icc
  · exact isPavingAnalytic_isPavingAnalytic
      (hs.mono fun _ ↦ MeasurableSet.isPavingAnalytic_image2_prod)

/-- The projection of an analytic set for the product of the paving of measurable sets and the
paving of closed intervals is analytic for the paving of measurable sets. Variant of
Theorem 1.32 (3) of [he2019semimartingale]. -/
lemma isPavingAnalytic_fst_of_image2_prod_measurableSet_Icc {ι : Type*} [LinearOrder ι]
    [TopologicalSpace ι] [OrderTopology ι] [CompactIccSpace ι] [MeasurableSpace 𝓧]
    {s : Set (𝓧 × ι)}
    (hs : IsPavingAnalytic (Set.image2 (· ×ˢ ·) {t | MeasurableSet t}
      (insert ∅ {t | ∃ a b, Set.Icc a b = t})) s) :
    IsPavingAnalytic {t | MeasurableSet t} (Prod.fst '' s) :=
  hs.fst (isCompactSystem_insert_empty_Icc ι)

/-- The projection of a measurable set of `𝓧 × ℝ` is analytic for the paving of measurable
sets. -/
lemma _root_.MeasurableSet.isPavingAnalytic_fst {m𝓧 : MeasurableSpace 𝓧} {s : Set (𝓧 × ℝ)}
    (hs : MeasurableSet s) :
    IsPavingAnalytic {t | MeasurableSet t} (Prod.fst '' s) :=
  isPavingAnalytic_fst_of_image2_prod_measurableSet_Icc hs.isPavingAnalytic_image2_prod

/-- A set `s` of a measurable space `𝓧` is measurably analytic for a measurable space `𝓚` if it
is the projection of a measurable set of `𝓧 × 𝓚`. -/
def IsMeasurableAnalyticFor (𝓚 : Type*) [MeasurableSpace 𝓚] [MeasurableSpace 𝓧] (s : Set 𝓧) :
    Prop :=
  ∃ t : Set (𝓧 × 𝓚), MeasurableSet t ∧ s = Prod.fst '' t

lemma isMeasurableAnalyticFor_of_snd {_ : MeasurableSpace 𝓚} [MeasurableSpace 𝓧]
    {s : Set 𝓧} (t : Set (𝓚 × 𝓧)) (ht : MeasurableSet t) (hst : s = Prod.snd '' t) :
    IsMeasurableAnalyticFor 𝓚 s :=
  ⟨Prod.swap ⁻¹' t, ht.preimage (by fun_prop), by ext; simp [hst]⟩

/-- A set `s` of a measurable space `𝓧` is measurably analytic if it is the projection of
a measurable set of `𝓧 × ℝ`. -/
def IsMeasurableAnalytic [MeasurableSpace 𝓧] (s : Set 𝓧) : Prop := IsMeasurableAnalyticFor ℝ s

lemma isMeasurableAnalytic_of_snd [MeasurableSpace 𝓧] {s : Set 𝓧} (t : Set (ℝ × 𝓧))
    (ht : MeasurableSet t) (hst : s = Prod.snd '' t) :
    IsMeasurableAnalytic s :=
  isMeasurableAnalyticFor_of_snd t ht hst

/-- If a set is measurably analytic for some standard Borel space `𝓚`,
then it is measurably analytic for `ℝ`. -/
lemma IsMeasurableAnalyticFor.isMeasurableAnalytic {m𝓧 : MeasurableSpace 𝓧}
    {m𝓚 : MeasurableSpace 𝓚} [StandardBorelSpace 𝓚]
    (hs : IsMeasurableAnalyticFor 𝓚 s) :
    IsMeasurableAnalytic s := by
  obtain ⟨t, ht, rfl⟩ := hs
  refine ⟨Prod.map id (embeddingReal 𝓚) '' t, ?_, by ext; simp⟩
  refine MeasurableEmbedding.measurableSet_image' ?_ ht
  exact MeasurableEmbedding.id.prodMap (measurableEmbedding_embeddingReal 𝓚)

lemma _root_.MeasurableSet.isMeasurableAnalytic {m𝓧 : MeasurableSpace 𝓧} (hs : MeasurableSet s) :
    IsMeasurableAnalytic s :=
  ⟨s ×ˢ Set.univ, hs.prod .univ, by ext; simp⟩

lemma IsMeasurableAnalytic.isPavingAnalytic {m𝓧 : MeasurableSpace 𝓧} (hs : IsMeasurableAnalytic s) :
    IsPavingAnalytic {t | MeasurableSet t} s := by
  obtain ⟨t, ht, rfl⟩ := hs
  exact MeasurableSet.isPavingAnalytic_fst ht

end MeasureTheory
