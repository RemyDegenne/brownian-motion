/-!
# Uniformly integrable martingales are closed

In a Banach space with the Radon-Nikodym property, a uniformly integrable martingale `X` indexed
by a directed set is closed: there is an integrable function `Z` such that `X i = P[Z | 𝓕 i]`
almost surely for all `i`.

## Main statements

* `MeasureTheory.Martingale.exists_ae_eq_condExp_of_uniformIntegrable`: in a space with the
  Radon-Nikodym property, a uniformly integrable martingale is closed.

## Implementation notes

We first assume that the σ-algebra is generated by the filtration. The sets which are measurable at
some time are then dense, and for such a set `s` the integral of `X i` over `s` does not depend on
`i` for `i` large enough. By uniform integrability, the integrals of `X i` over any measurable set
converge, and the limit is a vector measure of bounded variation which is absolutely continuous
with respect to `P`. Its density closes the martingale.

-/

public section

open Filter Function
open scoped ENNReal NNReal Topology symmDiff

namespace MeasureTheory

variable {Ω ι E : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [NormedAddCommGroup E]
  [NormedSpace ℝ E] {X : ι → Ω → E} {C : ℝ≥0}

section Limit

/-! ### Limits of integrals of a uniformly integrable family -/

variable {l : Filter ι} [l.NeBot]

/-- If the functions `X i` are bounded in `L¹` by `C` and if their integrals over the sets `A b`
of a finite family of disjoint measurable sets converge to `ν₀ (A b)`, then the sum of the norms
of the `ν₀ (A b)` is at most `C`. -/
private lemma sum_enorm_le_of_tendsto_setIntegral (hC : ∀ i, eLpNorm (X i) 1 P ≤ C) {β : Type*}
    (F : Finset β) (A : β → Set Ω) (hA_disj : (F : Set β).PairwiseDisjoint A)
    (hA : ∀ b ∈ F, MeasurableSet (A b)) {ν₀ : Set Ω → E}
    (hν₀ : ∀ b ∈ F, Tendsto (fun i ↦ ∫ ω in A b, X i ω ∂P) l (𝓝 (ν₀ (A b)))) :
    ∑ b ∈ F, ‖ν₀ (A b)‖ₑ ≤ C := by
  have h_tendsto : Tendsto (fun i ↦ ∑ b ∈ F, ‖∫ ω in A b, X i ω ∂P‖ₑ) l
      (𝓝 (∑ b ∈ F, ‖ν₀ (A b)‖ₑ)) :=
    tendsto_finsetSum _ fun b hb ↦ (continuous_enorm.tendsto _).comp (hν₀ b hb)
  refine le_of_tendsto' h_tendsto fun i ↦ ?_
  calc ∑ b ∈ F, ‖∫ ω in A b, X i ω ∂P‖ₑ
    _ ≤ ∑ b ∈ F, ∫⁻ ω in A b, ‖X i ω‖ₑ ∂P :=
      Finset.sum_le_sum fun b _ ↦ enorm_integral_le_lintegral_enorm _
    _ = ∫⁻ ω in ⋃ b ∈ F, A b, ‖X i ω‖ₑ ∂P := (lintegral_biUnion_finset hA_disj hA _).symm
    _ ≤ ∫⁻ ω, ‖X i ω‖ₑ ∂P := setLIntegral_le_lintegral _ _
    _ ≤ eLpNorm (X i) 1 P := lintegral_enorm_le_eLpNorm_one
    _ ≤ C := hC i

/-- If `X` is a uniformly integrable family of functions, bounded in `L¹`, whose integrals over
every measurable set converge along a filter, then the limits of the integrals define a vector
measure of bounded variation which is absolutely continuous with respect to `P`. -/
private lemma exists_vectorMeasure_forall_tendsto_setIntegral [IsFiniteMeasure P]
    (hX_int : ∀ i, Integrable (X i) P) (hUI : UnifIntegrable X 1 P)
    (hC : ∀ i, eLpNorm (X i) 1 P ≤ C)
    (h_lim : ∀ s, MeasurableSet s → ∃ x, Tendsto (fun i ↦ ∫ ω in s, X i ω ∂P) l (𝓝 x)) :
    ∃ ν : VectorMeasure Ω E, IsFiniteMeasure ν.variation ∧ ν ≪ᵥ P.toENNRealVectorMeasure ∧
      ∀ s, MeasurableSet s → Tendsto (fun i ↦ ∫ ω in s, X i ω ∂P) l (𝓝 (ν s)) := by
  classical
  choose! ν₁ hν₁ using h_lim
  let ν₀ : Set Ω → E := fun s ↦ if MeasurableSet s then ν₁ s else 0
  have hν₀ (s : Set Ω) (hs : MeasurableSet s) :
      Tendsto (fun i ↦ ∫ ω in s, X i ω ∂P) l (𝓝 (ν₀ s)) := by
    simpa [ν₀, hs] using hν₁ s hs
  -- `ν₀` is additive, and small on sets of small measure
  have hν₀_add {s t : Set Ω} (hs : MeasurableSet s) (ht : MeasurableSet t) (hst : Disjoint s t) :
      ν₀ (s ∪ t) = ν₀ s + ν₀ t :=
    tendsto_nhds_unique (hν₀ _ (hs.union ht)) (((hν₀ s hs).add (hν₀ t ht)).congr fun i ↦
      (setIntegral_union hst ht (hX_int i).integrableOn (hX_int i).integrableOn).symm)
  have hν₀_small {ε : ℝ} (hε : 0 < ε) :
      ∃ δ > 0, ∀ s, MeasurableSet s → P s ≤ ENNReal.ofReal δ → ‖ν₀ s‖ ≤ ε := by
    obtain ⟨δ, hδ, hδ'⟩ := unifIntegrable_iff.1 hUI (ENNReal.ofReal ε) (ENNReal.ofReal_pos.2 hε)
    obtain ⟨r, hr, hrδ⟩ := ENNReal.lt_iff_exists_nnreal_btwn.1 hδ
    refine ⟨r, mod_cast ENNReal.coe_pos.1 hr, fun s hs hPs ↦ le_of_tendsto' (hν₀ s hs).norm
      fun i ↦ ?_⟩
    have h : ‖∫ ω in s, X i ω ∂P‖ₑ ≤ ENNReal.ofReal ε :=
      (enorm_integral_le_lintegral_enorm _).trans (lintegral_enorm_le_eLpNorm_one.trans
        (hδ' i s (hPs.trans (by simpa using hrδ.le))))
    rwa [← ofReal_norm, ENNReal.ofReal_le_ofReal_iff hε.le] at h
  -- hence it is countably additive
  have hν₀_iUnion ⦃A : ℕ → Set Ω⦄ (hA : ∀ k, MeasurableSet (A k))
      (hA_disj : Pairwise (Disjoint on A)) :
      HasSum (fun k ↦ ν₀ (A k)) (ν₀ (⋃ k, A k)) := by
    have h_summable : Summable fun k ↦ ‖ν₀ (A k)‖ := by
      simp only [← toReal_enorm]
      refine ENNReal.summable_toReal (ne_of_lt ?_)
      exact (ENNReal.tsum_le_of_sum_range_le fun n ↦
        sum_enorm_le_of_tendsto_setIntegral hC (Finset.range n) A (fun i _ j _ hij ↦ hA_disj hij)
          (fun k _ ↦ hA k) fun k _ ↦ hν₀ _ (hA k)).trans_lt ENNReal.coe_lt_top
    rw [hasSum_iff_tendsto_nat_of_summable_norm h_summable]
    have hU (n : ℕ) : MeasurableSet (⋃ k ∈ Finset.range n, A k) :=
      Finset.measurableSet_biUnion _ fun k _ ↦ hA k
    have hT (n : ℕ) : MeasurableSet (⋃ k ≥ n, A k) := .iUnion fun k ↦ .iUnion fun _ ↦ hA k
    have h_fin (n : ℕ) : ∑ k ∈ Finset.range n, ν₀ (A k) = ν₀ (⋃ k ∈ Finset.range n, A k) := by
      refine tendsto_nhds_unique (tendsto_finsetSum _ fun k _ ↦ hν₀ _ (hA k))
        ((hν₀ _ (hU n)).congr fun i ↦ ?_)
      exact integral_biUnion_finset _ (fun k _ ↦ hA k) (fun i _ j _ hij ↦ hA_disj hij)
        fun k _ ↦ (hX_int i).integrableOn
    have h_split (n : ℕ) :
        ν₀ (⋃ k, A k) = ν₀ (⋃ k ∈ Finset.range n, A k) + ν₀ (⋃ k ≥ n, A k) := by
      rw [← hν₀_add (hU n) (hT n)]
      · congr 1
        ext ω
        simp only [Set.mem_iUnion, Set.mem_union, Finset.mem_range, exists_prop]
        refine ⟨fun ⟨k, hk⟩ ↦ ?_, ?_⟩
        · exact (lt_or_ge k n).imp (fun h ↦ ⟨k, h, hk⟩) fun h ↦ ⟨k, h, hk⟩
        · rintro (⟨k, -, hk⟩ | ⟨k, -, hk⟩) <;> exact ⟨k, hk⟩
      · refine Set.disjoint_left.2 fun ω hω hω' ↦ ?_
        simp only [Set.mem_iUnion, Finset.mem_range, exists_prop] at hω hω'
        obtain ⟨k, hk, hωk⟩ := hω
        obtain ⟨k', hk', hωk'⟩ := hω'
        exact Set.disjoint_left.1 (hA_disj (hk.trans_le hk').ne) hωk hωk'
    rw [Metric.tendsto_atTop]
    intro ε hε
    obtain ⟨δ, hδ, hδ'⟩ := hν₀_small (half_pos hε)
    have h_tail : Tendsto (fun n ↦ P (⋃ k ≥ n, A k)) atTop (𝓝 0) :=
      tendsto_measure_biUnion_Ici_zero_of_pairwise_disjoint
        (fun k ↦ (hA k).nullMeasurableSet) hA_disj
    obtain ⟨n₀, hn₀⟩ := eventually_atTop.1
      ((tendsto_order.1 h_tail).2 _ (ENNReal.ofReal_pos.2 hδ))
    refine ⟨n₀, fun n hn ↦ ?_⟩
    rw [h_fin, h_split n, dist_eq_norm, sub_add_cancel_left, norm_neg]
    exact (hδ' _ (hT n) (hn₀ n hn).le).trans_lt (half_lt_self hε)
  -- it defines a vector measure, with the required properties
  let ν : VectorMeasure Ω E :=
    { measureOf' := ν₀
      empty' := by simpa using hν₀_add MeasurableSet.empty MeasurableSet.empty (by simp)
      not_measurable' := fun s hs ↦ by simp [ν₀, hs]
      m_iUnion' := hν₀_iUnion }
  refine ⟨ν, ⟨lt_of_le_of_lt ?_ (ENNReal.coe_lt_top (r := C))⟩, ?_, hν₀⟩
  · by_contra! h
    obtain ⟨F, -, hF_disj, hF_meas, hF⟩ := ν.exists_lt_sum_of_lt_variation MeasurableSet.univ h
    exact hF.not_ge (sum_enorm_le_of_tendsto_setIntegral hC F id hF_disj hF_meas
      fun b hb ↦ hν₀ _ (hF_meas b hb))
  · refine VectorMeasure.AbsolutelyContinuous.mk fun s hs hPs ↦ ?_
    rw [Measure.toENNRealVectorMeasure_apply_measurable hs] at hPs
    refine tendsto_nhds_unique (hν₀ s hs) ?_
    simp [setIntegral_measure_zero _ hPs]

end Limit

section Martingale

/-! ### Uniformly integrable martingales are closed -/

variable [Preorder ι] [IsDirectedOrder ι] [IsFiniteMeasure P]

/-- If the σ-algebra is generated by a monotone family `𝓕` of σ-algebras, and if the integrals of
the uniformly integrable family `X` over the sets of `𝓕 i` satisfy the martingale property, then
the integrals of `X i` over any measurable set converge. -/
private lemma cauchySeq_setIntegral [Nonempty ι] {𝓕 : ι → MeasurableSpace Ω}
    (h𝓕_mono : Monotone 𝓕) (h𝓕 : ⨆ i, 𝓕 i = mΩ) (hX_int : ∀ i, Integrable (X i) P)
    (hX : ∀ i j, i ≤ j → ∀ s, MeasurableSet[𝓕 i] s → ∫ ω in s, X i ω ∂P = ∫ ω in s, X j ω ∂P)
    (hUI : UnifIntegrable X 1 P) {s : Set Ω} (hs : MeasurableSet s) :
    CauchySeq fun i ↦ ∫ ω in s, X i ω ∂P := by
  have h𝓕_le (i : ι) : 𝓕 i ≤ mΩ := h𝓕 ▸ le_iSup 𝓕 i
  -- the sets which are measurable at some time form a dense algebra of sets
  have h𝒜 : P.MeasureDense {s | ∃ i, MeasurableSet[𝓕 i] s} := by
    refine Measure.MeasureDense.of_generateFrom_isSetAlgebra_finite (μ := P)
      (h𝒜 := ⟨?_, ?_, ?_⟩) (hgen := h𝓕.symm.trans (MeasurableSpace.measurableSpace_iSup_eq 𝓕))
    · exact ⟨Classical.arbitrary ι, @MeasurableSet.empty _ (𝓕 _)⟩
    · rintro s ⟨i, hs⟩
      exact ⟨i, hs.compl⟩
    · rintro s t ⟨i, hs⟩ ⟨j, ht⟩
      obtain ⟨k, hik, hjk⟩ := exists_ge_ge i j
      exact ⟨k, (h𝓕_mono hik s hs).union (h𝓕_mono hjk t ht)⟩
  -- we approximate `s` by a set `t` which is measurable at time `j`
  refine Metric.cauchy_iff.2 ⟨inferInstance, fun ε hε ↦ ?_⟩
  obtain ⟨δ', hδ', hδ''⟩ := unifIntegrable_iff.1 hUI (ENNReal.ofReal (ε / 3))
    (ENNReal.ofReal_pos.2 (by positivity))
  obtain ⟨r, hr, hrδ⟩ := ENNReal.lt_iff_exists_nnreal_btwn.1 hδ'
  obtain ⟨t, ⟨j, ht⟩, hst⟩ := h𝒜.approx s hs (measure_ne_top _ _) r
    (mod_cast ENNReal.coe_pos.1 hr)
  have ht' : MeasurableSet t := h𝓕_le j t ht
  refine ⟨(fun i ↦ ∫ ω in s, X i ω ∂P) '' Set.Ici j, image_mem_map (Ici_mem_atTop j), ?_⟩
  rintro _ ⟨i, hi, rfl⟩ _ ⟨i', hi', rfl⟩
  have h_eq : ∫ ω in t, X i ω ∂P = ∫ ω in t, X i' ω ∂P :=
    (hX j i hi t ht).symm.trans (hX j i' hi' t ht)
  have h_sub (k : ι) : ‖∫ ω in s, X k ω ∂P - ∫ ω in t, X k ω ∂P‖ ≤ ε / 3 := by
    have h : ‖∫ ω in s, X k ω ∂P - ∫ ω in t, X k ω ∂P‖ₑ ≤ ENNReal.ofReal (ε / 3) := by
      rw [← integral_indicator hs, ← integral_indicator ht',
        ← integral_sub ((hX_int k).indicator hs) ((hX_int k).indicator ht')]
      refine (enorm_integral_le_lintegral_enorm _).trans (lintegral_enorm_le_eLpNorm_one.trans ?_)
      refine (eLpNorm_indicator_sub_indicator (X k) hs.nullMeasurableSet
        ht'.nullMeasurableSet).trans_le ?_
      rw [eLpNorm_indicator_eq_eLpNorm_restrict (hs.symmDiff ht').nullMeasurableSet]
      exact hδ'' k (s ∆ t) (hst.le.trans (by simpa using hrδ.le))
    rwa [← ofReal_norm, ENNReal.ofReal_le_ofReal_iff (by positivity)] at h
  calc dist (∫ ω in s, X i ω ∂P) (∫ ω in s, X i' ω ∂P)
    _ = ‖(∫ ω in s, X i ω ∂P - ∫ ω in t, X i ω ∂P)
        - (∫ ω in s, X i' ω ∂P - ∫ ω in t, X i' ω ∂P)‖ := by
      rw [dist_eq_norm, h_eq, sub_sub_sub_cancel_right]
    _ ≤ ε / 3 + ε / 3 := (norm_sub_le _ _).trans (add_le_add (h_sub i) (h_sub i'))
    _ < ε := by linarith

/-- Auxiliary lemma for `MeasureTheory.Martingale.exists_ae_eq_condExp_of_uniformIntegrable`,
in which the σ-algebra is generated by the filtration, and the martingale property is written in
terms of integrals. -/
private lemma exists_integrable_forall_setIntegral_eq [Nonempty ι] [HasRadonNikodymProp E]
    {𝓕 : ι → MeasurableSpace Ω} (h𝓕_mono : Monotone 𝓕) (h𝓕 : ⨆ i, 𝓕 i = mΩ)
    (hX_int : ∀ i, Integrable (X i) P)
    (hX : ∀ i j, i ≤ j → ∀ s, MeasurableSet[𝓕 i] s → ∫ ω in s, X i ω ∂P = ∫ ω in s, X j ω ∂P)
    (hUI : UnifIntegrable X 1 P) (hC : ∀ i, eLpNorm (X i) 1 P ≤ C) :
    ∃ Z : Ω → E, Integrable Z P ∧
      ∀ i s, MeasurableSet[𝓕 i] s → ∫ ω in s, Z ω ∂P = ∫ ω in s, X i ω ∂P := by
  have := HasRadonNikodymProp.completeSpace E
  have h𝓕_le (i : ι) : 𝓕 i ≤ mΩ := h𝓕 ▸ le_iSup 𝓕 i
  -- the integrals of `X i` over the measurable sets converge to a vector measure `ν`
  obtain ⟨ν, _, hν_ac, hν⟩ := exists_vectorMeasure_forall_tendsto_setIntegral hX_int hUI hC
    fun s hs ↦ cauchySeq_tendsto_of_complete (cauchySeq_setIntegral h𝓕_mono h𝓕 hX_int hX hUI hs)
  -- its density closes the martingale
  obtain ⟨Z, hZ_int, hZ⟩ := HasRadonNikodymProp.exists_withDensityᵥ_eq P ν hν_ac
  refine ⟨Z, hZ_int, fun i s hs ↦ ?_⟩
  rw [← withDensityᵥ_apply hZ_int (h𝓕_le i s hs), hZ]
  exact tendsto_nhds_unique (hν s (h𝓕_le i s hs)) (tendsto_const_nhds.congr'
    ((eventually_ge_atTop i).mono fun j hj ↦ hX i j hj s hs))

/-- In a space with the Radon-Nikodym property, a uniformly integrable martingale `X` is closed:
there exists an integrable function `Z` such that `X i = P[Z | 𝓕 i]` almost surely for all `i`.
Furthermore `Z` can be taken measurable with respect to `⨆ i, 𝓕 i`. -/
theorem Martingale.exists_ae_eq_condExp_of_uniformIntegrable [CompleteSpace E]
    [HasRadonNikodymProp E] {𝓕 : Filtration ι mΩ} (hX : Martingale X 𝓕 P)
    (hUI : UniformIntegrable X 1 P) :
    ∃ Z : Ω → E, StronglyMeasurable[⨆ i, 𝓕 i] Z ∧ Integrable Z P ∧
      ∀ i, X i =ᵐ[P] P[Z | 𝓕 i] := by
  rcases isEmpty_or_nonempty ι with hι | hι
  · exact ⟨0, stronglyMeasurable_zero, integrable_zero _ _ _, fun i ↦ isEmptyElim i⟩
  have hle : ⨆ i, 𝓕 i ≤ mΩ := iSup_le 𝓕.le
  have hX_sm (i : ι) : StronglyMeasurable[⨆ i, 𝓕 i] (X i) :=
    (hX.stronglyAdapted i).mono (le_iSup (fun i ↦ 𝓕 i) i)
  obtain ⟨C, hC⟩ := hUI.2
  -- we apply the auxiliary lemma on the σ-algebra generated by the filtration
  obtain ⟨Z, hZ_int, hZ⟩ := exists_integrable_forall_setIntegral_eq (mΩ := ⨆ i, 𝓕 i)
    (P := P.trim hle) (𝓕 := fun i ↦ 𝓕 i) (fun _ _ hij ↦ 𝓕.mono hij) rfl (X := X)
    (fun i ↦ (hX.integrable i).trim hle (hX_sm i))
    (fun i j hij s hs ↦ by
      have hs' : MeasurableSet[⨆ i, 𝓕 i] s := le_iSup (fun i ↦ 𝓕 i) i s hs
      rw [← setIntegral_trim hle (hX_sm i) hs', ← setIntegral_trim hle (hX_sm j) hs']
      exact hX.setIntegral_eq hij hs)
    (unifIntegrable_iff'.2 fun ε hε ↦ by
      obtain ⟨δ, hδ, hδ'⟩ := unifIntegrable_iff'.1 hUI.1 ε hε
      refine ⟨δ, hδ, fun i s hs hPs ↦ ?_⟩
      rw [restrict_trim hle _ hs, eLpNorm_trim hle (hX_sm i)]
      exact hδ' i s (hle s hs) (by rwa [trim_measurableSet_eq hle hs] at hPs))
    (C := C) (fun i ↦ by rw [eLpNorm_trim hle (hX_sm i)]; exact hC i)
  have hZ₀_sm : StronglyMeasurable[⨆ i, 𝓕 i] (hZ_int.1.mk Z) := hZ_int.1.stronglyMeasurable_mk
  have hZ₀_int : Integrable (hZ_int.1.mk Z) P :=
    integrable_of_integrable_trim hle (hZ_int.congr hZ_int.1.ae_eq_mk)
  refine ⟨hZ_int.1.mk Z, hZ₀_sm, hZ₀_int, fun i ↦ ?_⟩
  refine ae_eq_condExp_of_forall_setIntegral_eq (𝓕.le i) hZ₀_int
    (fun s _ _ ↦ (hX.integrable i).integrableOn) (fun s hs _ ↦ ?_)
    (hX.stronglyAdapted i).aestronglyMeasurable
  have hs' : MeasurableSet[⨆ i, 𝓕 i] s := le_iSup (fun i ↦ 𝓕 i) i s hs
  rw [setIntegral_trim hle hZ₀_sm hs', setIntegral_trim hle (hX_sm i) hs', ← hZ i s hs]
  exact setIntegral_congr_ae hs' (hZ_int.1.ae_eq_mk.mono fun ω hω _ ↦ hω)

end Martingale

end MeasureTheory
